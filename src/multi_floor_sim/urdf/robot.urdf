<?xml version="1.0"?>

<robot name="thesis_robot">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.68 0.44 0.18"/>
      </geometry>
    </visual>
  </link>


  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.07"/>
      </geometry>
    </visual>
  </link>


  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.08 0.06 0.03"/>
      </geometry>
    </visual>
  </link>


  <!-- LiDAR外参 -->
  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin
      xyz="0.05 0 0.34"
      rpy="0 0 0"/>

  </joint>


  <!-- IMU外参 -->
  <joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin
      xyz="-0.13 0 0.305"
      rpy="0 0 0"/>

  </joint>


</robot>
