Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Known Map1
        - /Aligned Scan1
      Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Pose Estimate1
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Reference Frame: map
      Plane: XY
      Plane Cell Count: 30
      Cell Size: 1
      Alpha: 0.35
      Color: 110; 110; 110
      Line Style:
        Value: Lines
        Line Width: 0.03
    - Class: rviz_default_plugins/Axes
      Name: Map Axes
      Enabled: true
      Value: true
      Reference Frame: map
      Length: 1
      Radius: 0.04
    # Both publishers use reliable, volatile QoS. The map repeats at 1 Hz.
    - Class: rviz_default_plugins/PointCloud2
      Name: Known Map
      Enabled: true
      Value: true
      Topic:
        Value: /known_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 150; 180; 210
      Alpha: 0.65
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Decay Time: 0
      Use Fixed Frame: true
      Selectable: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Aligned Scan
      Enabled: true
      Value: true
      Topic:
        Value: /localization/aligned_scan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 100; 30
      Alpha: 1
      Style: Points
      Size (Pixels): 4
      Size (m): 0.05
      Decay Time: 0
      Use Fixed Frame: true
      Selectable: true
    - Class: rviz_default_plugins/Pose
      Name: Localized Base Pose
      Enabled: true
      Value: true
      Topic:
        Value: /localization/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape: Arrow
      Color: 60; 255; 100
      Alpha: 1
      Shaft Length: 0.6
      Shaft Radius: 0.04
      Head Length: 0.2
      Head Radius: 0.1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Update Interval: 0
      Frames:
        All Enabled: true
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 32; 35; 40
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891945200942
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Angle: 0
      Scale: 35
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  X: 60
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: false
